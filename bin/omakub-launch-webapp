#!/bin/bash

set -e

# omakub-launch-webapp: Launch a web application as a standalone window.
# Usage: omakub-launch-webapp <app-url> <app-name> [desktop-id]

if [[ -z $1 || -z $2 ]]; then
  echo "Usage: omakub-launch-webapp <app-url> <app-name> [desktop-id]" >&2
  exit 1
fi

webapp_slug() {
  local value="$1"
  value=$(echo "$value" | tr '[:upper:]' '[:lower:]')
  value=$(echo "$value" | sed 's/[^a-z0-9]/-/g; s/-\+/-/g; s/^-//; s/-$//')
  if [[ -z $value ]]; then
    value="webapp"
  fi
  echo "$value"
}

resolve_browser_exec() {
  local default_browser candidate
  local -a candidates=()

  default_browser=$(xdg-settings get default-web-browser 2>/dev/null || true)

  case $default_browser in
    google-chrome*) candidates=(google-chrome-stable google-chrome) ;;
    brave-browser*) candidates=(brave-browser) ;;
    microsoft-edge*) candidates=(microsoft-edge-stable microsoft-edge) ;;
    opera*) candidates=(opera) ;;
    vivaldi*) candidates=(vivaldi-stable vivaldi) ;;
    helium*) candidates=(helium) ;;
    chromium*) candidates=(chromium chromium-browser) ;;
    *) candidates=(chromium chromium-browser google-chrome-stable google-chrome brave-browser microsoft-edge-stable microsoft-edge opera vivaldi-stable vivaldi helium) ;;
  esac

  for candidate in "${candidates[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

APP_URL="$1"
APP_NAME="$2"
DESKTOP_ID="$3"

if [[ -n $DESKTOP_ID ]]; then
  APP_SLUG="${DESKTOP_ID#omakub-webapp-}"
  if [[ -z $APP_SLUG || $APP_SLUG == $DESKTOP_ID ]]; then
    APP_SLUG=$(webapp_slug "$APP_NAME")
  fi
  APP_CLASS="$DESKTOP_ID"
  CHROME_DESKTOP_FILE="$DESKTOP_ID.desktop"
else
  APP_SLUG=$(echo "$APP_NAME" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
  APP_CLASS=$(echo "$APP_NAME" | sed 's/[^a-zA-Z0-9]//g' | tr '[:upper:]' '[:lower:]')
  CHROME_DESKTOP_FILE="$APP_NAME.desktop"
fi

if [[ -z $APP_SLUG ]]; then
  APP_SLUG=$(webapp_slug "$APP_NAME")
fi

if [[ -z $APP_CLASS ]]; then
  APP_CLASS="omakub-webapp-$APP_SLUG"
fi

# This prevents data loss and force to open in a separate profile
OMAKUB_DATA_DIR="$HOME/.config/omakub/webapp"
WEBAPP_DATA_DIR="$OMAKUB_DATA_DIR/$APP_SLUG"
if [[ ! -d $WEBAPP_DATA_DIR ]]; then
  mkdir -p "$WEBAPP_DATA_DIR"
fi

export CHROME_DESKTOP="$CHROME_DESKTOP_FILE"

if ! browser_exec=$(resolve_browser_exec); then
  echo "Error: Chromium-based browser not found." >&2
  exit 1
fi

exec "$browser_exec" \
  --user-data-dir="$WEBAPP_DATA_DIR" \
  --window-size=800,600 \
  --app="$APP_URL" \
  --class="$APP_CLASS" \
  --name="$APP_NAME"
